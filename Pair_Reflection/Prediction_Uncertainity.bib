  title = {Unveil {{Sources}} of {{Uncertainty}}: {{Feature Contribution}} to {{Conformal Prediction Intervals}}},
  shorttitle = {Unveil {{Sources}} of {{Uncertainty}}},
  author = {Idrissi, Marouane Il and Machado, Agathe Fernandes and Gallic, Ewen and Charpentier, Arthur},
  year = 2025,
